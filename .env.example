# Doll City - environment variables
#
# Copy this file to `.env.local` and fill in your own Supabase project values.
# The game works fully WITHOUT these set - it falls back to local-only save
# (IndexedDB) so a child can always play offline / before backend is configured.
#
# NEVER put a Supabase service-role secret here - this file is loaded into the
# browser bundle by Vite, so only the public anon/publishable key belongs here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
